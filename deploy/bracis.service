# Serviço do systemd: liga o site quando o servidor liga e religa se ele cair.
# Instalação: sudo cp deploy/bracis.service /etc/systemd/system/bracis.service

[Unit]
Description=Site de ocupação das salas do BRACIS 2026
After=network.target

[Service]
# Troque USUARIO pelo seu usuário no servidor.
User=USUARIO
WorkingDirectory=/opt/bracis
# --host 127.0.0.1: só o Nginx (na mesma máquina) acessa o site direto; a internet passa pelo Nginx.
# --workers 1: o bloqueio de tentativas de login e a leitura da planilha ficam na memória
#   de um processo só. Com vários, cada um teria a sua cópia.
# --proxy-headers: deixa o site saber o IP real de quem acessa (que o Nginx repassa).
#   Só confia no Nginx (127.0.0.1, o padrão). Só acrescente outro proxy em --forwarded-allow-ips
#   se tiver certeza de que ele acrescenta o IP do visitante em vez de repassar o que o visitante mandar;
#   senão, qualquer um poderia inventar o próprio IP.
ExecStart=/opt/bracis/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
